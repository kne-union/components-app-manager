{
  "name": "@kne-components/components-app-manager",
  "version": "0.1.0",
  "description": "应用中心前端组件：应用管理后台与用户侧应用中心，配合 @kne/fastify-app-manager 使用.",
  "scripts": {
    "init": "husky",
    "start": "cross-env PORT=3012 COMPONENTS_NAME=components-app-manager MODULES_DEV_PUBLIC_URL=/ craco start",
    "build": "cross-env COMPONENTS_NAME=components-app-manager MODULES_DEV_PUBLIC_URL=components-app-manager craco build",
    "create": "modules-dev-create",
    "test": "craco test --coverage",
    "eject": "react-scripts eject",
    "prettier": "prettier --config .prettierrc --write '{src/**/*}.{js,jsx,ts,tsx,json,css,scss}'",
    "lint-staged": "npx lint-staged",
    "build:docs": "modules-dev-build-docs"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json,css,scss}": [
      "prettier --config .prettierrc --write",
      "git add"
    ]
  },
  "files": [
    "build"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kne-union/components-app-manager.git"
  },
  "keywords": [
    "app-manager",
    "app-center",
    "remote-components",
    "pm2",
    "deployment",
    "kne"
  ],
  "author": "linzp",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kne-union/components-app-manager/issues"
  },
  "homepage": "https://www.kne-union.top/#/components",
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "moduleNameMapper": {
      "^@common/(.*)": "<rootDir>/src/common/$1",
      "^@components/(.*)": "<rootDir>/src/components/$1",
      "^@utils/(.*)": "<rootDir>/src/common/utils/$1"
    }
  },
  "devDependencies": {
    "@craco/craco": "^7.1.0",
    "@kne/modules-dev": "^2.4.17",
    "@kne/react-fetch": "^1.4.3",
    "@kne/remote-loader": "^1.4.5",
    "@loadable/component": "^5.16.3",
    "@testing-library/jest-dom": "^6.4.2",
    "antd": "^5.14.2",
    "axios": "^1.6.7",
    "classnames": "^2.5.1",
    "cross-env": "^7.0.3",
    "http-proxy-middleware": "^2.0.6",
    "husky": "^9.0.11",
    "lodash": "^4.17.21",
    "prettier": "^3.2.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.2",
    "sass": "^1.75.0"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@kne/axios-fetch": "^1.2.4",
    "@kne/json-view": "^0.1.3",
    "@kne/pwa-document": "^0.1.0",
    "@kne/react-intl": "^0.1.15",
    "@kne/responsive-utils": "^0.1.16",
    "dayjs": "^1.11.20"
  }
}
